# Optional - only needed to change the defaults below.
# By default, generation uses a local Ollama server, no API key required.

# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=granite4:3b   # the default; won `uv run faq-rag bench` (see eval/results.md)
# LLM_MODEL=llama3.2:3b   # the runner-up: about 20% faster, statistically tied on answers

# OPENAI_API_KEY is only needed if your OpenAI-compatible server requires one
# (Ollama doesn't).
# OPENAI_API_KEY=
